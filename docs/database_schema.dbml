Table users {
  id            int           [pk, increment]
  email         varchar(255)  [unique, null]
  phone         varchar(30)   [unique, null]
  password_hash varchar(255)  [null]
  auth_provider varchar(50)   [null]
  auth_provider_id varchar(255) [null]
  role          varchar(20)   [not null, default: 'user']
  is_blocked    boolean       [not null, default: false]
  created_at    timestamp     [not null, default: `now()`]
  updated_at    timestamp     [not null, default: `now()`]

  indexes {
    email
    auth_provider_id
  }
}

Table profiles {
  id            int           [pk, increment]
  user_id       int           [not null, unique, ref: > users.id]
  display_name  varchar(100)  [not null]
  avatar_url    varchar(500)  [null]
  bio           text          [null]
  city          varchar(100)  [null]
  avg_rating    decimal(3,2)  [not null, default: 0]
  reviews_count int           [not null, default: 0]
  updated_at    timestamp     [not null, default: `now()`]
}

Table categories {
  id        int          [pk, increment]
  parent_id int          [null, ref: > categories.id]
  name      varchar(100) [not null]
  slug      varchar(100) [not null, unique]
}

Table tags {
  id    int          [pk, increment]
  name  varchar(100) [not null, unique]
  slug  varchar(100) [not null, unique]
}

Table services {
  id          int           [pk, increment]
  user_id     int           [not null, ref: > users.id]
  category_id int           [null, ref: > categories.id]
  title       varchar(255)  [not null]
  description text          [not null]
  price       decimal(10,2) [null]
  price_type  varchar(20)   [not null, default: 'fixed']
  status      varchar(20)   [not null, default: 'pending']
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]

  indexes {
    user_id
    category_id
    status
  }
}

Table service_photos {
  id          int          [pk, increment]
  service_id  int          [not null, ref: > services.id]
  url         varchar(500) [not null]
  sort_order  int          [not null, default: 0]
}

Table service_tags {
  service_id  int  [not null, ref: > services.id]
  tag_id      int  [not null, ref: > tags.id]

  indexes {
    (service_id, tag_id) [pk]
  }
}

Table deals {
  id          int          [pk, increment]
  client_id   int          [not null, ref: > users.id]
  executor_id int          [not null, ref: > users.id]
  service_id  int          [null, ref: > services.id]
  status      varchar(20)  [not null, default: 'in_progress']
  created_at  timestamp    [not null, default: `now()`]
  completed_at timestamp   [null]

  indexes {
    client_id
    executor_id
  }
}

Table reviews {
  id          int          [pk, increment]
  deal_id     int          [not null, ref: > deals.id]
  author_id   int          [not null, ref: > users.id]
  target_id   int          [not null, ref: > users.id]
  rating      smallint     [not null]
  comment     text         [null]
  created_at  timestamp    [not null, default: `now()`]

  indexes {
    deal_id
    target_id
  }
}

Table conversations {
  id          int          [pk, increment]
  deal_id     int          [null, ref: > deals.id]
  created_at  timestamp    [not null, default: `now()`]
}

Table conversation_participants {
  conversation_id  int  [not null, ref: > conversations.id]
  user_id          int  [not null, ref: > users.id]
  joined_at        timestamp [not null, default: `now()`]

  indexes {
    (conversation_id, user_id) [pk]
  }
}

Table messages {
  id               int       [pk, increment]
  conversation_id  int       [not null, ref: > conversations.id]
  sender_id        int       [not null, ref: > users.id]
  content          text      [not null]
  is_read          boolean   [not null, default: false]
  created_at       timestamp [not null, default: `now()`]

  indexes {
    conversation_id
    sender_id
  }
}

Table favorite_services {
  id          int       [pk, increment]
  user_id     int       [not null, ref: > users.id]
  service_id  int       [not null, ref: > services.id]
  created_at  timestamp [not null, default: `now()`]

  indexes {
    (user_id, service_id) [unique]
  }
}

Table favorite_users {
  id            int       [pk, increment]
  user_id       int       [not null, ref: > users.id]
  target_user_id int      [not null, ref: > users.id]
  created_at    timestamp [not null, default: `now()`]

  indexes {
    (user_id, target_user_id) [unique]
  }
}

Table albums {
  id          int          [pk, increment]
  user_id     int          [not null, ref: > users.id]
  name        varchar(150) [not null]
  created_at  timestamp    [not null, default: `now()`]
}

Table album_items {
  id          int       [pk, increment]
  album_id    int       [not null, ref: > albums.id]
  service_id  int       [not null, ref: > services.id]
  added_at    timestamp [not null, default: `now()`]

  indexes {
    (album_id, service_id) [unique]
  }
}

Table notifications {
  id                  int          [pk, increment]
  user_id             int          [not null, ref: > users.id]
  type                varchar(50)  [not null]
  related_entity_type varchar(50)  [null]
  related_entity_id   int          [null]
  is_read             boolean      [not null, default: false]
  created_at          timestamp    [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table moderation_queue {
  id                  int          [pk, increment]
  entity_type         varchar(50)  [not null]
  entity_id           int          [not null]
  status              varchar(20)  [not null, default: 'pending']
  moderator_id        int          [null, ref: > users.id]
  rejection_reason    text         [null]
  created_at          timestamp    [not null, default: `now()`]
  reviewed_at         timestamp    [null]

  indexes {
    status
    entity_type
  }
}

Table support_tickets {
  id          int          [pk, increment]
  user_id     int          [null, ref: > users.id]
  subject     varchar(255) [not null]
  message     text         [not null]
  status      varchar(20)  [not null, default: 'open']
  assigned_to int          [null, ref: > users.id]
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`]
}
